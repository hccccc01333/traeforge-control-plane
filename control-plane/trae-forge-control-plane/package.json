{
  "name": "trae-forge-control-plane",
  "displayName": "TraeForge Control Plane",
  "description": "Local enterprise plugin control plane for TRAE.",
  "version": "0.5.0",
  "publisher": "traeforge-local",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:traeforge.openControlPlane",
    "onView:traeforge.controlPlane"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "traeforge.openControlPlane",
        "title": "TraeForge: Open Control Plane",
        "category": "TraeForge"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "traeforge",
          "title": "TraeForge",
          "icon": "./media/traeforge.svg"
        }
      ]
    },
    "views": {
      "traeforge": [
        {
          "type": "webview",
          "id": "traeforge.controlPlane",
          "name": "Control Plane"
        }
      ]
    }
  }
}
